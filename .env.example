# Default is a clearly labelled browser-local demo. No database or secrets needed.
APP_MODE=demo

# Live mode requires PostgreSQL, two distinct random secrets (32+ characters),
# migrations, at least one account, and manager-confirmed operational settings.
# APP_MODE=live
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# SESSION_SECRET=
# QR_SECRET=
# APP_URL=https://your-project.vercel.app
APP_TIME_ZONE=Asia/Kolkata

# Optional real Warden integration. Use a separate randomly generated secret.
# WARDEN_WEBHOOK_SECRET=
# ML works in both demo and live modes. For local setup use npm run ml:setup,
# then npm run dev:ml. Setup generates a private key in .env.local.
# In production deploy Python separately and set the same key on both services.
# ML_SERVICE_URL=https://your-python-service.example.com
# ML_API_KEY=

# For local database integration tests only, using a dedicated disposable database.
# TEST_DATABASE_URL=postgresql://smart_mess@127.0.0.1:54329/smart_mess_test
